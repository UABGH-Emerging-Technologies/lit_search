#!/usr/bin/env bash
# lit_search — Code Ocean master script.
#
# Executed headlessly by Code Ocean (./run) after the capsule loads and secrets
# are injected as environment variables (Code Ocean User Secrets). Creates the
# results directory, exposes it via $RESULTS_DIR, and hands off to the Python
# driver that runs the full 5-step pipeline in-process.
#
# SECURITY: secrets are never echoed. No xtrace. No .env reads.
set -euo pipefail

# Work from this script's own directory so relative paths resolve anywhere.
cd "$(dirname "$0")"
export PYTHONPATH="$PWD"

# Resolve where pipeline outputs should be written.
#  1. Keep an explicitly-set $RESULTS_DIR.
#  2. /results exists (the Code Ocean standard results mount).
#  3. Fall back to ./results next to the repo.
if [[ -z "${RESULTS_DIR:-}" ]]; then
  if [[ -d "/results" ]]; then
    RESULTS_DIR="/results"
  else
    RESULTS_DIR="$PWD/results"
  fi
fi
mkdir -p "$RESULTS_DIR"
export RESULTS_DIR

exec python3 scripts/capsule_driver.py "$@"