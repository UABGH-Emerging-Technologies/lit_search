# Version control / history (never bake git history or its secrets into an image)
.git
.gitignore
.gitmodules

# Secrets and local env
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# Exploration / notebooks / scratch (not needed at runtime)
explorations/
*.ipynb
logs/
tmp.txt
*.dat

# Docs, site, and design artifacts
docs/
site/
mkdocs.yml
*.plantuml
*.png

# Local tooling / IDE
.vscode/
.devcontainer/
workspace.code-workspace
.streamlit/

# Python caches and build artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/
venv/
.venv/

# Tests (image is for serving, not testing)
tests/
pytest.ini
