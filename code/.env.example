# ── lit_search environment template ──────────────────────────────────────
# Quick start:
#   1. cp .env.example .env
#   2. fill in the real values below
#   3. docker compose up --build   (or `make run` for a host run)
#
# How the values reach the app:
#   Docker — Compose auto-loads .env and delivers each value as a Docker
#     secret at /run/secrets/<name> inside the container.
#   Host (`make run`) — the Makefile exports .env into the environment, where
#     aiweb_common.manage_sensitive() finds it via its env-var fallback.
# The variable names below are lowercase on purpose: both paths require an
# exact match with the secret name, so keep them as-is.
#
# Prefer file-based secrets over a .env? See the `secrets:` block at the
# bottom of docker-compose.yml for the `file:` alternative.

# LLM proxy used by the Streamlit frontend (injected into backend requests /
# Authorization header). Any OpenAI-compatible endpoint + key works.
azure_proxy_key=
azure_proxy_endpoint=

# Backend data-source keys (no inline comments here — the Makefile exports
# this file verbatim, and trailing text would become part of the value)
# Library Key API (full-text access links):
libkey_api_key=
# NCBI Entrez / PubMed:
ncbi_api_key=

# ── Optional overrides (sane defaults exist; leave unset unless needed) ────
# OPENAI_COMPATIBLE_MODEL=gpt-4o
# LIT_ENDPOINT=http://localhost:8000   # backend URL for `make run` on the host
# LIT_API_PORT=8000                    # host port for the backend service
# LIT_STREAMLIT_PORT=8501              # host port for the frontend service
